# 监听端口
PORT=3001
HOST=127.0.0.1

# SQLite 数据库文件
DATABASE_PATH=./data/releasehub.db

# 固件文件存储根目录
FIRMWARE_STORAGE_DIR=./storage/firmware

# 会话密钥（生产环境务必随机生成 32 字节十六进制：openssl rand -hex 32）
# 必须 64 位十六进制字符
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cookie 安全标志（生产 HTTPS 下设为 true）
COOKIE_SECURE=false

# 上传文件大小上限（字节），默认 10MB
MAX_UPLOAD_BYTES=10485760

# Nginx X-Accel-Redirect 内部下载路径前缀（与 nginx.conf 中 internal location 对应）
# 若为空字符串，则由 Node 直接 sendFile（开发环境用）
XACCEL_REDIRECT_PREFIX=

# CORS 允许的来源（开发时填前端地址，多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173
